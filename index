      <div class="icon">
        ◎
      </div>

      <b>
        Digitalisasi
      </b>

      <p>
        Membuat proses pemesanan lebih digital dan terstruktur.
      </p>

    </div>



    <div class="goal">

      <div class="icon">
        ↗
      </div>

      <b>
        Efisiensi
      </b>

      <p>
        Mempercepat proses dari melihat menu sampai mengirim order.
      </p>

    </div>



    <div class="goal">

      <div class="icon">
        ✓
      </div>

      <b>
        Akurasi
      </b>

      <p>
        Mengurangi risiko kesalahan pencatatan detail pesanan.
      </p>

    </div>



    <div class="goal">

      <div class="icon">
        ▦
      </div>

      <b>
        Multi-Restaurant
      </b>

      <p>
        Mendukung banyak restoran dalam satu platform dengan data terpisah.
      </p>

    </div>

  </div>

</section>



<!-- =====================================================
     SLIDE 05 — CUSTOMER & ADMIN FLOW
===================================================== -->

<section class="slide">

  <div class="top">

    <div class="brand">
      Menu Digital QR Restaurant
    </div>

    <div class="counter">
      05 / 08
    </div>

  </div>


  <div class="eyebrow">
    System Flow
  </div>


  <h2>
    From customer order<br>
    to <span class="accent">admin process.</span>
  </h2>


  <div class="flowbox">

    <div class="label">
      Customer Process
    </div>

    <div class="flow">

      <div class="node">
        Scan QR Code
      </div>

      <i class="arr">→</i>

      <div class="node">
        Validasi Restoran<br>
        Meja · Lokasi
      </div>

      <i class="arr">→</i>

      <div class="node">
        Menu Digital
      </div>

      <i class="arr">→</i>

      <div class="node">
        Pilih Menu<br>
        Variant · Addon · Qty
      </div>

      <i class="arr">→</i>

      <div class="node">
        Checkout
      </div>

      <i class="arr">→</i>

      <div class="node">
        Create Order
      </div>

    </div>

  </div>



  <div class="flowbox">

    <div class="label">
      Admin Process
    </div>

    <div class="flow">

      <div class="node">
        Receive Order
      </div>

      <i class="arr">→</i>

      <div class="node">
        Review Order
      </div>

      <i class="arr">→</i>

      <div class="node">
        Accept / Reject
      </div>

      <i class="arr">→</i>

      <div class="node">
        Processing
      </div>

      <i class="arr">→</i>

      <div class="node">
        Update Status
      </div>

      <i class="arr">→</i>

      <div class="node">
        Completed
      </div>

    </div>

  </div>



  <div class="flowbox">

    <div class="label">
      Admin Management
    </div>

    <div class="admin-modules">

      <div class="node">
        Dashboard
      </div>

      <div class="node">
        Menu
      </div>

