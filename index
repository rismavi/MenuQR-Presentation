<!doctype html>
<html lang="id">

<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>MenuQR — Project Presentation</title>

<style>

:root{
  --navy:#14213d;
  --blue:#2563eb;
  --text:#172033;
  --muted:#64748b;
  --line:#e5eaf2;
  --soft:#f6f8fc;
  --blue-soft:#eef4ff;
}

*{
  box-sizing:border-box;
}

html,
body{
  margin:0;
  width:100%;
  height:100%;
  overflow:hidden;
}

body{
  font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;
  color:var(--text);
  background:#fff;
}

.deck{
  width:100vw;
  height:100vh;
  position:relative;
}

.slide{
  position:absolute;
  inset:0;
  padding:7vh 8vw 8vh;
  display:flex;
  flex-direction:column;
  justify-content:center;
  opacity:0;
  transform:translateX(40px);
  pointer-events:none;
  transition:.35s ease;
  background:#fff;
}

.slide.active{
  opacity:1;
  transform:none;
  pointer-events:auto;
}

.top{
  position:absolute;
  top:25px;
  left:8vw;
  right:8vw;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.brand{
  font-size:10px;
  font-weight:900;
  color:var(--navy);
  letter-spacing:.15em;
  text-transform:uppercase;
}

.counter{
  font-size:12px;
  color:var(--muted);
  font-weight:800;
}

.eyebrow{
  text-transform:uppercase;
  letter-spacing:.16em;
  font-size:11px;
  color:var(--blue);
  font-weight:900;
  margin-bottom:13px;
}

h1{
  font-size:clamp(50px,7.5vw,88px);
  line-height:.92;
  letter-spacing:-.06em;
  color:var(--navy);
  margin:0 0 16px;
}

h2{
  font-size:clamp(32px,4.3vw,55px);
  line-height:.97;
  letter-spacing:-.055em;
  color:var(--navy);
  margin:0 0 24px;
}

p{
  color:var(--muted);
  line-height:1.55;
  margin:0;
}

.accent{
  color:var(--blue);
}

.subtitle{
  font-size:clamp(17px,1.9vw,24px);
  color:var(--muted);
}

.meta{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-top:25px;
}

.pill{
  padding:8px 13px;
  border:1px solid var(--line);
  border-radius:99px;
  background:var(--soft);
  font-size:11px;
  font-weight:800;
  color:var(--navy);
}


/* =====================================================
   SLIDE 02 — TEAM
===================================================== */

.people{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:17px;
  align-items:stretch;
}

.person{
  text-align:center;
  padding:20px 17px 18px;
  border:1px solid var(--line);
  border-radius:24px;
  background:#fff;
  box-shadow:0 10px 28px #14213d0a;
}

.photo{
  width:105px;
  height:105px;
  border-radius:50%;
  object-fit:cover;
  display:block;
  margin:0 auto 13px;
  border:5px solid #f0f4fa;
  background:#eaf0f8;
}

.person strong{
  display:block;
  color:var(--navy);
  font-size:14px;
  line-height:1.35;
}

.person span{
  display:block;
  font-size:11px;
  color:var(--muted);
  margin-top:3px;
}

.role{
  display:inline-block;
  margin-top:9px;
  padding:5px 10px;
  border-radius:99px;
  background:var(--blue-soft);
  color:var(--blue);
  font-size:10px;
  font-weight:900;
  font-style:normal;
}


/* =====================================================
   SLIDE 03 — PROBLEM
===================================================== */

.why{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:17px;
}

.box{
  padding:27px;
  border-radius:24px;
  border:1px solid var(--line);
}

.box.dark{
  background:var(--navy);
  border-color:var(--navy);
}

.box.dark h3{
  color:#fff;
}

.box.dark p{
  color:#dbe6f8;
}

.box h3{
  color:var(--navy);
  font-size:24px;
  margin:0 0 10px;
}

.box p{
  font-size:13px;
}


/* =====================================================
   SLIDE 04 — GOALS
===================================================== */

.goals{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:13px;
}

.goal{
  padding:20px;
  border:1px solid var(--line);
  border-radius:20px;
  background:#fff;
  box-shadow:0 8px 25px #14213d08;
}

.goal b{
  display:block;
  color:var(--navy);
  margin:11px 0 6px;
  font-size:14px;
}

.goal p{
  font-size:12px;
}

.icon{
  font-size:23px;
  color:var(--blue);
  font-weight:800;
}


/* =====================================================
   SLIDE 05 — CUSTOMER & ADMIN FLOW
===================================================== */

.flowbox{
  padding:17px 19px;
  border:1px solid var(--line);
  border-radius:21px;
  background:var(--soft);
  margin-bottom:11px;
}

.label{
  text-transform:uppercase;
  letter-spacing:.12em;
  font-size:10px;
  color:var(--blue);
  font-weight:900;
  margin-bottom:9px;
}

.flow{
  display:flex;
  align-items:center;
  gap:6px;
  flex-wrap:wrap;
}

.node{
  padding:9px 11px;
  border:1px solid #dce3ee;
  border-radius:11px;
  background:#fff;
  color:var(--navy);
  font-size:10px;
  font-weight:850;
  text-align:center;
}

.arr{
  color:var(--blue);
  font-weight:900;
  font-style:normal;
}

.admin-modules{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
}

.admin-modules .node{
  background:#fff;
  color:var(--navy);
}


/* =====================================================
   SLIDE 06 — SYSTEM FLOWCHART
===================================================== */

.chart{
  display:grid;
  grid-template-columns:1fr 1fr;
  grid-template-rows:auto auto;
  gap:12px;
  width:100%;
  max-width:100%;
}

.chartbox{
  border:1px solid var(--line);
  border-radius:18px;
  padding:13px;
  background:#fff;
  min-width:0;
}

.chartbox h3{
  color:var(--navy);
  margin:0 0 8px;
  font-size:13px;
  line-height:1.2;
}


/* CUSTOMER FLOW */

.vertical{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:2px;
}

.vnode{
  width:100%;
  max-width:100%;
  padding:6px 8px;
  border:1px solid #dce3ee;
  border-radius:8px;
  background:#fff;
  color:var(--navy);
  font-size:8.5px;
  line-height:1.2;
  text-align:center;
  font-weight:750;
}

.down{
  color:var(--blue);
  font-weight:900;
  font-size:9px;
  line-height:1;
}

.decision{
  width:42px;
  height:42px;
  transform:rotate(45deg);
  border:1px solid #ccd7e8;
  background:#f7faff;
  display:grid;
  place-items:center;
  margin:4px 0;
}

.decision span{
  transform:rotate(-45deg);
  font-size:7px;
  font-weight:900;
  color:var(--navy);
}

.branches{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:5px;
  width:100%;
}

.branches div{
  padding:6px;
  border-radius:8px;
  background:var(--soft);
  font-size:7.5px;
  line-height:1.2;
  text-align:center;
  font-weight:800;
}


/* ADMIN FLOW */

.admin-flow{
  display:flex;
  flex-direction:column;
  gap:2px;
}

.admin-node{
  width:100%;
  padding:6px 8px;
  border:1px solid #dce3ee;
  border-radius:8px;
  background:#fff;
  color:var(--navy);
  font-size:8.5px;
  line-height:1.2;
  text-align:center;
  font-weight:750;
}

.admin-node.primary{
  background:var(--navy);
  border-color:var(--navy);
  color:#fff;
}

.admin-status{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:5px;
  margin:4px 0;
}

.admin-status div{
  padding:6px;
  border-radius:8px;
  background:var(--soft);
  color:var(--navy);
  font-size:7.5px;
  line-height:1.2;
  font-weight:800;
  text-align:center;
}


/* MULTI RESTAURANT */

.multi-restaurant{
  grid-column:1 / -1;
}

.restaurant-row{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:6px;
  width:100%;
}

.restaurant-row .node{
  width:100%;
  padding:7px;
  font-size:8.5px;
  line-height:1.25;
}

.restaurant-row small{
  font-size:7px;
  color:var(--muted);
}

.isolation{
  margin-top:8px;
  padding-top:8px;
  border-top:1px solid var(--line);
}

.isolation-title{
  color:var(--navy);
  font-size:9px;
  font-weight:900;
  margin-bottom:4px;
}

.isolation p{
  font-size:8px;
  line-height:1.35;
}


/* SLIDE 06 POSITION ONLY — flow unchanged */

.slide:nth-child(6){
  justify-content:flex-start;
  padding-top:clamp(68px,7vh,82px);
}

.slide:nth-child(6) .eyebrow{
  margin-bottom:10px;
  line-height:1.1;
}

.slide:nth-child(6) h2{
  font-size:clamp(27px,2.9vw,38px);
  line-height:1.02;
  letter-spacing:-.045em;
  margin:0 0 20px;
}


/* =====================================================
   SLIDE 07 — TECHNOLOGY STACK
===================================================== */

.tech-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
}

.tech-card{
  min-height:105px;
  padding:16px;
  border:1px solid var(--line);
  border-radius:19px;
  display:flex;
  align-items:center;
  gap:13px;
  background:#fff;
  box-shadow:0 8px 24px #14213d08;
}

.tech-icon{
  width:50px;
  height:50px;
  flex:0 0 50px;
  border-radius:14px;
  background:var(--blue-soft);
  display:grid;
  place-items:center;
}

.tech-icon img{
  width:29px;
  height:29px;
  object-fit:contain;
  display:block;
}

.tech-card h3{
  text-transform:uppercase;
  letter-spacing:.1em;
  color:var(--blue);
  font-size:9px;
  margin:0 0 7px;
}

.tags{
  display:flex;
  gap:5px;
  flex-wrap:wrap;
}

.tag{
  font-size:9.5px;
  padding:5px 7px;
  border-radius:7px;
  background:var(--soft);
  font-weight:800;
  color:var(--navy);
}


/* =====================================================
   SLIDE 08 — DEMO
===================================================== */

.demo-final{
  align-items:center;
  text-align:center;
}

.demo-final .eyebrow{
  margin-bottom:12px;
}

.demo-final h2{
  margin-bottom:24px;
}

.demo-card{
  width:min(700px,100%);
  min-height:245px;
  border-radius:30px;
  background:linear-gradient(145deg,#12213d,#203c6c);
  display:grid;
  place-items:center;
  text-align:center;
  box-shadow:0 20px 55px rgba(18,33,61,.16);
}

.play{
  width:74px;
  height:74px;
  border-radius:50%;
  border:0;
  background:#fff;
  color:var(--blue);
  display:grid;
  place-items:center;
  margin:auto;
  cursor:pointer;
  font-size:25px;
  box-shadow:0 13px 35px rgba(0,0,0,.2);
  transition:.2s;
}

.play:hover{
  transform:scale(1.06);
}

.demo-card h3{
  color:#fff;
  font-size:28px;
  letter-spacing:.05em;
  margin:16px 0 0;
}

.demo-card p{
  color:#cbd8ec;
  font-size:12px;
  margin-top:7px;
}


/* =====================================================
   CONTROLS
===================================================== */

.controls{
  position:fixed;
  right:25px;
  bottom:23px;
  display:flex;
  gap:7px;
  align-items:center;
  z-index:5;
}

.controls button{
  width:42px;
  height:42px;
  border:1px solid var(--line);
  background:#fff;
  border-radius:12px;
  color:var(--navy);
  font-size:17px;
  cursor:pointer;
}

.dots{
  display:flex;
  gap:5px;
  margin-right:5px;
}

.dot{
  width:7px;
  height:7px;
  border-radius:9px;
  background:#d8dfeb;
}

.dot.active{
  width:20px;
  background:var(--blue);
}


/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width:1000px){

  .tech-grid{
    grid-template-columns:1fr 1fr;
  }

}

@media(max-width:800px){

  html,
  body{
    overflow:hidden;
  }

  .slide{
    padding:76px 25px 82px;
    overflow:auto;
    justify-content:flex-start;
  }

  .top{
    left:25px;
    right:25px;
  }

  .people,
  .why,
  .chart,
  .tech-grid{
    grid-template-columns:1fr;
  }

  .multi-restaurant{
    grid-column:auto;
  }

  .goals{
    grid-template-columns:1fr 1fr;
  }

  .restaurant-row{
    grid-template-columns:1fr;
  }

}

@media(max-width:560px){

  .goals{
    grid-template-columns:1fr;
  }

  .people{
    grid-template-columns:1fr;
  }

}


/* =====================================================
   EXTRA SMALL SCREEN
===================================================== */

@media(max-height:700px) and (min-width:801px){

  .slide{
    padding-top:65px;
    padding-bottom:65px;
  }

  .slide:nth-child(6){
    justify-content:flex-start;
  }

  .slide:nth-child(6) h2{
    font-size:32px;
    margin-bottom:10px;
  }

  .chart{
    gap:9px;
  }

  .chartbox{
    padding:10px;
  }

  .vnode,
  .admin-node{
    padding:5px 7px;
    font-size:8px;
  }

  .decision{
    width:36px;
    height:36px;
  }

  .branches div,
  .admin-status div{
    padding:5px;
    font-size:7px;
  }

}


/* =====================================================
   PRINT / SCREENSHOT
===================================================== */

@media print{

  html,
  body{
    overflow:visible;
    height:auto;
  }

  .slide{
    position:relative;
    opacity:1;
    transform:none;
    pointer-events:auto;
    min-height:100vh;
    page-break-after:always;
  }

  .controls{
    display:none;
  }

}

</style>
</head>


